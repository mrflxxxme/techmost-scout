# Секреты — никогда в репозиторий
.env
.env.*
!.env.example
*.pem
*.key

# Данные и результаты работы
data/*.db
data/*.db.bak-*
data/scout.db.bak*
backend/data/
data/*.db-journal
data/*.sqlite*
out/
!out/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Редакторы и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Локальные заметки агентов
.claude/settings.local.json

# Рабочие копии сессий и исполнителей (РЕШ-29): сами по себе они уже в git
.claude/worktrees/

# Служебное состояние инструментов сессии
.omc/
