# ─────────────────────────────────────────────────────────────────────────────
# ТехМост Скаут — переменные окружения
#
# Скопируйте этот файл в .env и заполните. Имена переменных совпадают с
# проектом TEAMLY_RU: значения переносятся скриптом
#   .venv\Scripts\python.exe scripts\import_keys.py
# вручную ничего править не нужно. (Скрипт на Python, потому что политика
# запуска PowerShell-скриптов на машине требует цифровую подпись.)
#
# Что обязательно для первого запуска — помечено ОБЯЗАТЕЛЬНО.
# Полные инструкции по получению каждого ключа: docs/deps-manual.md
#
# Файл хранится в UTF-8 без BOM и значений не содержит: секрет живёт только в
# .env, которого нет в репозитории (инвариант №3).
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Вход в веб-интерфейс (личных кабинетов в MVP нет, вход общий)
WEB_AUTH_USER=scout
WEB_AUTH_PASSWORD=change-me

# ── Языковые модели ──────────────────────────────────────────────────────────
# Качественные стадии (карточки, проверка, сводка). Внимание: 24.07.2026
# алиасы deepseek-chat и deepseek-reasoner отключены — нужно явное имя модели.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Аварийный резерв модели. Ключ API предпочтительнее IAM-токена (не протухает).
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_CATALOG_ID=
YANDEX_MODEL=yandexgpt-lite/latest

LLM_PROVIDER_TIMEOUT_SECONDS=120
FX_RATE_USD_TO_RUB=100.0

# на длинном структурированном JSON (план поиска, батч оценок, карточка) он
# обрывает ответ на середине — это проверено живыми прогонами. Остальное считает
# DeepSeek: при измеренных 3–5 ₽ на запрос экономить на этом нечего.
# Порядок меняется правкой этой строки, без изменения кода.

# ── Поисковые источники ──────────────────────────────────────────────────────
# Работают без ключа: Crossref, КиберЛенинка, arXiv, OpenAlex. Роспатента
# в этом списке больше нет: с Т-14 адаптер ходит в поисковую платформу, и
# без ROSPATENT_API_KEY он не собирается вовсе.

# Условие вежливого доступа Crossref: он просит контакт в User-Agent.
CROSSREF_MAILTO=uklonskiy.k@gmail.com

# Ключ НЕ обязателен: живая анонимная проба 17.08.2026 (только mailto) ответила
# 200 и вернула тариф в заголовках — $0,001 за запрос (те же $1 за 1000 вызовов)
# при суточной бесплатной норме $0,10, то есть сто поисковых запросов в сутки.
# Поиском пользуемся, расход печатается в конце `scout run`. Ключ нужен только
# обогащению по DOI: без него оно пропускается. Получить: openalex.org/settings/api
OPENALEX_API_KEY=

# Необязателен: без ключа лимит общий на всех пользователей.
SEMANTICSCHOLAR_API_KEY=

# Патенты США. Источник отклонён (РЕШ-172): адаптер — заготовка, переменная
# читается кодом, но в прогоне не участвует. Оставьте пустой.
PATENTSVIEW_API_KEY=

# Поиск по русскоязычному вебу (сайты институтов, страницы грантов). Платно,
# ≈50–200 ₽ за 1000 запросов. Бесплатной альтернативы больше нет: у Brave
# Search бесплатный тариф закрыт в феврале 2026.
YANDEX_SEARCH_API_KEY=

# Поисковая платформа Роспатента. ОБЯЗАТЕЛЕН: с Т-14 режима «без ключа» у
# адаптера нет, и без этого значения источник не собирается — патентов в
# отчёте не будет ни одного.
ROSPATENT_API_KEY=

# ── Ограничители ─────────────────────────────────────────────────────────────
SEARCH_TIMEOUT_SECONDS=30
MAX_CANDIDATES_PER_QUERY=20
TARGET_CARDS=6
# Стоп-кран: запрос прерывается, если машинная обработка вышла дороже.
COST_LIMIT_RUB_PER_REQUEST=20

# Отсечка по предметному соответствию: кандидат с оценкой relevance ниже
# порога до карточек не доходит. 0 — отсечка выключена. Значение подбирается
# по журналу калибровки живого прогона, а не угадывается.
# RELEVANCE_MIN=3

# Условный второй проход поиска (Т-21): если максимум relevance по оценкам
# модели первой выдачи строго ниже порога, план перестраивается и поиск идёт
# второй раз. 0 — проход выключен. Поднимать только по итогам живого прогона:
# цена ошибки — лишний платный проход на каждом запросе.
# SECOND_PASS_RELEVANCE_MAX=6

# База данных. SQLite достаточно для MVP; переход на Postgres — замена строки.
# По умолчанию (без этой переменной) база живёт в <корень репозитория>/data/scout.db —
# путь абсолютный, от каталога запуска не зависит. Относительный путь здесь создаст
# вторую базу при запуске из другого каталога — задавайте только абсолютный.
# DATABASE_URL=sqlite+aiosqlite:///C:/полный/путь/до/data/scout.db

# JSON-API /api/v1 для продуктов экосистемы (РЕШ-250, docs/deploy.md §3).
# Ключи клиентов через запятую; пусто — API закрыт. Значения ключей — только в .env.
SCOUT_API_KEYS=
# Не больше N запусков прогона в час на ключ и M чтений в минуту.
API_RATE_LIMIT_RUNS_PER_HOUR=5
API_RATE_LIMIT_READS_PER_MINUTE=60

# Публичный экспресс-скан «Рынка» (этап 6, РЕШ-254…265). Хост публичного режима:
# пусто — публичного режима нет; до регистрации домена — плейсхолдер sslip (РЕШ-273).
PUBLIC_SCAN_HOST=
# Сканов с одного адреса в сутки (сутки — UTC+3).
SCAN_LIMIT_PER_IP_PER_DAY=2
# Суточный потолок всех сканов, ₽: модели + запросы Яндекса × тариф (РЕШ-258, 269).
SCAN_DAILY_BUDGET_RUB=300
# Стоп-кран одного скана, ₽ — только модели (РЕШ-269).
SCAN_COST_LIMIT_RUB=10
# Тариф Яндекс Поиска за запрос, ₽ (480 ₽ за 1000 синхронных, yandex.cloud/ru/docs/search-api/pricing, 18.10.2026).
YANDEX_SEARCH_RUB_PER_QUERY=0.48
# Куда ведёт кнопка «Заказать полный отчёт»: ссылка https://t.me/… и/или почта.
# Оба пусты — кнопки нет.
SCAN_ORDER_TELEGRAM_URL=
SCAN_ORDER_EMAIL=

# Демо-режим по умолчанию (переключатель «демо» скрывает служебные элементы)
DEMO_MODE_DEFAULT=false

# Маршрутизация моделей (РЕШ-171: DeepSeek — основной, ГигаЧат выпилен).
# Значения ниже совпадают с умолчаниями кода — переопределять только сознательно.
LLM_STAGE_ROUTES=intake:deepseek,extractor:deepseek,planner:deepseek,replan:deepseek,scorer:deepseek,card_author:deepseek,verifier:deepseek,summary:deepseek
LLM_FALLBACK_ORDER=deepseek,yandex

# Имя научного со-основателя для предзаполнения формы вердикта (этап 4, РЕШ-197)
# REVIEWER_NAME=
# Длительность демо-показа в секундах (этап 4, РЕШ-201; умолчание 150)
# DEMO_DURATION_SECONDS=150
