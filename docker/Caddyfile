# Обратный прокси. Три плейсхолдера подставляются вручную при деплое
# (домен, почта ACME, хэш пароля) — договорено в плане этапа Э5, раздел
# «Контракты, закреплённые планом».
#
# Глобальный блок обязателен: без email Let's Encrypt выпускает сертификат
# без контакта, и уведомления об истечении срока действия идти некуда.
{
    email admin@example.ru
}

# basic_auth дублирует вход самого приложения намеренно (РЕШ-16): пароль
# приложения защищает данные, пароль прокси прячет сам факт существования
# сервиса — два рубежа, а не один и тот же дважды.
#
# Хэш пароля получить командой: caddy hash-password --plaintext 'пароль'
# (тот же бинарник, что и в образе caddy:2-alpine). Строка ниже —
# плейсхолдер, а не рабочий хэш: подставляется при деплое.
scout.example.ru {
    encode gzip

    # JSON-API приложений (РЕШ-250) идёт мимо пароля: его защищает ключ
    # приложения в самом Скауте, пароля прокси у приложения нет.
    @ui not path /api/v1/*
    basic_auth @ui {
        scout ХЭШ_ПАРОЛЯ_ЗАМЕНИТЬ_ПРИ_ДЕПЛОЕ
    }

    reverse_proxy scout:8000

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        # Внутренний инструмент компании: попадать в поисковую выдачу не должен.
        X-Robots-Tag "noindex, nofollow"
    }
}
